# Connection settings for the MyKnowledge agent (identifiers, not secrets).
TENANT_ID=29034800-5f6e-4317-9a5b-23b1e1b985bf
CLIENT_ID=191ed9e4-cda5-4978-918c-333acd11feda
ENVIRONMENT_ID=1df61fa7-e8c3-e4f7-be8a-2751e060fb0e
AGENT_SCHEMA_NAME=craf4_MyKnowledgeAILabBuild
TOKEN_SCOPE=https://api.powerplatform.com/.default

# The service account the agent is called as. Username only.
# The password is typed into the Microsoft sign-in window by `python login.py`.
# Never put it in this file.
SERVICE_ACCOUNT_USERNAME=

# Where login.py saves the sign-in (MSAL token cache). Treat it like a password.
TOKEN_CACHE_PATH=./.secrets/msal_cache.bin

# true = serve fake answers so the UI works without signing in.
MOCK_AGENT=false
# MOCK_DELAY_SECONDS=0.5

# Links to these hosts are removed from answers (visitors cannot open them).
# STRIP_LINK_HOSTS=sharepoint.com
# MAX_QUESTION_CHARS=2000
# true = serve Swagger UI at /docs (local testing only).
# ENABLE_DOCS=false

# Shared password for every page and API call (browser asks for it; any username).
# Empty = no password (fine on your own machine only).
# APP_PASSWORD=
# true = refuse to start without APP_PASSWORD (set on Render).
# REQUIRE_APP_PASSWORD=false
